{
  "name": "oh-my-clipboard",
  "version": "1.3.0",
  "description": "A macOS menu bar clipboard history app.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jgmh99/OH-MY-CLIPBOARD.git"
  },
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "electron .",
    "build": "vite build",
    "dist": "electron-builder --mac --publish never",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "lint:commits": "commitlint --from origin/main --to HEAD"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "electron": "latest",
    "electron-builder": "latest",
    "semantic-release": "^24.2.9",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.ohmyclipboard.app",
    "productName": "Oh My Clipboard",
    "directories": {
      "buildResources": "icons"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "oh-my-clipboard.icns",
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "icon": "oh-my-clipboard.icns"
    },
    "publish": {
      "provider": "github",
      "owner": "jgmh99",
      "repo": "OH-MY-CLIPBOARD"
    }
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "semver": "^7.8.1"
  }
}
